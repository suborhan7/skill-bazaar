// Prints supabase/seed.sql from the sample data in src/lib/seed.ts.
// Run: npm run seed:sql
import { writeFileSync } from "node:fs";
import { SEED_LISTINGS, SEED_SELLERS } from "../src/lib/seed.ts";

const q = (v: string | null) => (v === null ? "null" : `'${v.replace(/'/g, "''")}'`);
const lines: string[] = [
  "-- Generated by `npm run seed:sql` from src/lib/seed.ts. Sample people, not real users.",
  "begin;",
];

for (const s of SEED_SELLERS) {
  const email = `${s.name.toLowerCase().replace(/\s+/g, ".")}@example.com`;
  lines.push(
    `insert into auth.users (id, email, aud, role) values (${q(s.id)}, ${q(email)}, 'authenticated', 'authenticated') on conflict do nothing;`,
    `insert into profiles (id, full_name, bio, area, campus, level, bkash_number, contact_url) values (${q(s.id)}, ${q(s.name)}, ${q(s.bio)}, ${q(s.area)}, ${q(s.campus)}, ${q(s.level)}, ${q(s.bkash)}, ${q(s.contactUrl)}) on conflict do nothing;`,
  );
  for (const b of s.badges) {
    lines.push(
      `insert into verifications (profile_id, type, status, checked_at) values (${q(s.id)}, ${q(b)}, 'approved', now()) on conflict do nothing;`,
    );
  }
}

for (const l of SEED_LISTINGS) {
  lines.push(
    `insert into listings (id, seller_id, title, category, description, delivery_days, online, sample_caption) values (${q(l.id)}, ${q(l.sellerId)}, ${q(l.title)}, ${q(l.category)}, ${q(l.description)}, ${l.deliveryDays}, ${l.online}, ${q(l.sampleCaption)}) on conflict do nothing;`,
  );
  for (const p of l.packages) {
    lines.push(
      `insert into packages (listing_id, tier, price_bdt, includes) values (${q(l.id)}, ${q(p.tier)}, ${p.priceBdt}, ${q(p.includes)}) on conflict do nothing;`,
    );
  }
}

lines.push("commit;", "");
writeFileSync(new URL("../supabase/seed.sql", import.meta.url), lines.join("\n"));
console.log("Wrote supabase/seed.sql");
